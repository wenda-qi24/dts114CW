@startuml
actor Dreamer
actor "Freudian AI Analyst" as FreudianAIAnalyst
actor Administrator

rectangle "Freudian Dream Interpretation System" {
  usecase "Submit dream content" as SubmitDream
  usecase "Generate follow-up questions" as GenerateQuestions
  usecase "Answer follow-up questions" as AnswerQuestions
  usecase "Produce Freudian analysis" as ProduceAnalysis
  usecase "Review past sessions" as ReviewSessions
  usecase "Manage session retention" as ManageRetention
}

Dreamer -- SubmitDream
Dreamer -- AnswerQuestions
Dreamer -- ProduceAnalysis
Dreamer -- ReviewSessions

FreudianAIAnalyst -- GenerateQuestions
FreudianAIAnalyst -- ProduceAnalysis

Administrator -- ManageRetention

SubmitDream ..> GenerateQuestions : <<include>>
GenerateQuestions ..> AnswerQuestions : <<include>>
AnswerQuestions ..> ProduceAnalysis : <<include>>

ReviewSessions ..> ManageRetention : <<extend>>
ManageRetention ..> ReviewSessions : <<extend>>
@enduml