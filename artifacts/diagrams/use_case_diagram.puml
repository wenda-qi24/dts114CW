@startuml
actor Dreamer
actor "Freudian AI Analyst" as FreudianAIAnalyst
actor Administrator

rectangle "Freudian Dream Interpretation System" {
  usecase "Submit new dream" as SubmitNewDream
  usecase "Generate follow-up questions" as GenerateFollowUpQuestions
  usecase "Answer follow-up questions" as AnswerFollowUpQuestions
  usecase "Produce full report" as ProduceFullReport
  usecase "Review past sessions" as ReviewPastSessions
  usecase "Administer users and sessions" as AdministerUsersAndSessions
}

Dreamer -- SubmitNewDream
Dreamer -- AnswerFollowUpQuestions
Dreamer -- ReviewPastSessions

FreudianAIAnalyst -- GenerateFollowUpQuestions
FreudianAIAnalyst -- ProduceFullReport

Administrator -- AdministerUsersAndSessions

SubmitNewDream ..> GenerateFollowUpQuestions : <<include>>
GenerateFollowUpQuestions ..> AnswerFollowUpQuestions : <<include>>
AnswerFollowUpQuestions ..> ProduceFullReport : <<include>>
@enduml